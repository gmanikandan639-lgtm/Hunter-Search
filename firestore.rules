rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function: Check if user is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Pre-authorized administrator emails for initial bootstrap
    function isPreAuthorizedAdminEmail() {
      return isAuthenticated() && (
        request.auth.token.email == 'hunter_admin@fraudriskhub.com' ||
        request.auth.token.email == 'gmanikandan639@gmail.com' ||
        request.auth.token.email == 'manikandan@frh.com'
      );
    }

    // Admin authorization: verified through database role or pre-authorized admin email
    function isAdmin() {
      return isAuthenticated() && (
        isPreAuthorizedAdminEmail() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    // 1. live_identifiers Collection (Master Searchable Database)
    // Normal/public users may READ/search the LIVE identifier data directly without login.
    // Only authenticated Admin users with role = "admin" may CREATE, UPDATE, DELETE.
    // Public writes are strictly forbidden.
    match /live_identifiers/{recordId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 2. visitor_stats Collection (Public can read today's count; controlled increment only)
    // Prevents arbitrary count manipulation while allowing today's counter to increment
    match /visitor_stats/{statId} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['id', 'date', 'visitor_count', 'visitorCount', 'created_at', 'createdAt', 'updated_at', 'updatedAt', 'timestamp', 'totalVisits', 'todayVisits', 'periodStartedAt', 'periodDateKey', 'uniqueSessions', 'lastVisit']) &&
        (request.resource.data.visitor_count == 1 || request.resource.data.visitorCount == 1 || request.resource.data.todayVisits == 1)
      );
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visitor_count', 'visitorCount', 'updated_at', 'updatedAt', 'timestamp', 'todayVisits', 'totalVisits', 'lastVisit']) &&
        (
          request.resource.data.visitor_count == resource.data.visitor_count + 1 ||
          request.resource.data.visitorCount == resource.data.visitorCount + 1 ||
          request.resource.data.todayVisits == resource.data.todayVisits + 1 ||
          request.resource.data.todayVisits == 1
        )
      );
      allow delete: if isAdmin();
    }

    // 3. submissions Collection (Admin management queue)
    // Public contribution removed; strictly Admin access.
    match /submissions/{submissionId} {
      allow read, write: if isAdmin();
    }

    // 4. users Collection (Role-Based Access Control)
    // Authenticated admin can read their own profile or all users.
    // Only Admin can write.
    match /users/{userId} {
      allow get: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 5. csv_metadata Collection (Dataset Metadata)
    match /csv_metadata/{metaId} {
      allow read, write: if isAdmin();
    }

    // 6. manual_identifiers Collection (Admin Manual Identifier Database)
    match /manual_identifiers/{recordId} {
      allow read, write: if isAdmin();
    }

    // 7. Auxiliary & Diagnostic Collections
    match /connection_test/{document} {
      allow read, write: if isAdmin();
    }

    match /search_history/{searchId} {
      allow read, write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    match /hunter_records/{recordId} {
      allow read, write: if isAdmin();
    }

    match /csv_datasets/{datasetId} {
      allow read, write: if isAdmin();
    }

    // Default Catch-All: Deny access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
