rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function: Check if user is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if user is the document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin authorization: checks users/{uid}.role field or authorized admin emails
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email == 'gmanikandan639@gmail.com' ||
          request.auth.token.email == 'admin_e2e@fraudriskhub.com'
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 1. live_identifiers Collection (Master Public Searchable Database)
    // Public users (no login required) can read approved/live identifiers.
    // Normal/unauthenticated users CANNOT create, update, or delete live identifiers.
    // Admin users have full CREATE, UPDATE, DELETE permissions.
    match /live_identifiers/{recordId} {
      allow read: if resource == null || resource.data.status in ['approved', 'live'] || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // 2. submissions Collection (Public Contributions & Proposals)
    // Public users (unauthenticated, request.auth may be null) can CREATE pending submissions only.
    // Public users CANNOT read other users' submissions, cannot modify after submission, cannot approve.
    // Admin users can read, review, approve, update, and reject submissions.
    match /submissions/{submissionId} {
      // Only Admin can read submissions
      allow read: if isAdmin();

      // Public users (or admins) can create submissions:
      // Validates: status must be 'pending', identifier non-empty, normalizedIdentifier present,
      // and admin approval fields CANNOT be set by public users.
      allow create: if (
        request.resource.data.status == 'pending' &&
        request.resource.data.identifier is string &&
        request.resource.data.identifier.size() > 0 &&
        request.resource.data.normalizedIdentifier is string &&
        request.resource.data.normalizedIdentifier.size() > 0 &&
        (!('approvedBy' in request.resource.data) || request.resource.data.approvedBy == null) &&
        (!('approvedAt' in request.resource.data) || request.resource.data.approvedAt == null) &&
        (!('reviewedBy' in request.resource.data) || request.resource.data.reviewedBy == null) &&
        (!('reviewedAt' in request.resource.data) || request.resource.data.reviewedAt == null) &&
        (!('rejectionReason' in request.resource.data) || request.resource.data.rejectionReason == null)
      ) || isAdmin();

      // Only Admin can update or delete submissions
      allow update, delete: if isAdmin();
    }

    // 3. users Collection (Admin Profiles & RBAC)
    // Normal public users do not have access.
    // Authenticated users can view their own profile; Admins have full access.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && (
        !('role' in request.resource.data) ||
        request.resource.data.role == 'user' ||
        isAdmin()
      );
      allow update: if (
        isOwner(userId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // 4. Existing Data Preservation: hunter_records Collection
    // Public can read to search existing datasets; Admin manages.
    match /hunter_records/{recordId} {
      allow read: if resource == null || resource.data.status in ['approved', 'live', null] || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // 5. Existing Data Preservation: manual_identifiers Collection
    // Public can read approved manual records; Admin manages.
    match /manual_identifiers/{recordId} {
      allow read: if resource == null || resource.data.status in ['approved', 'live', null] || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // 6. csv_metadata Collection
    // Tracks CSV exports and metadata. Public can read active metadata; Admin can write.
    match /csv_metadata/{metaId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 7. Connection Diagnostics Test Collection
    match /connection_test/{document} {
      allow read, write: if true;
    }

    // 8. Search History & Visitor Stats
    match /search_history/{searchId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /visitor_stats/{statId} {
      allow read, write: if true;
    }

    // 9. Admins mapping & csv_datasets
    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow write: if isAdmin();
    }

    match /csv_datasets/{datasetId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
